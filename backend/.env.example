# Copy to .env and fill in for local dev.

# Defaults to a local SQLite file if unset - zero setup to get running.
# For Postgres: postgresql+psycopg://user:password@localhost:5432/brt360
# (the Docker setup in deploy/compose sets this itself)
DATABASE_URL=sqlite:///./brt360.db

# Leave unset to run the deterministic rule-based classifier fallback
# (fully functional for dev/test, no external calls, no cost).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Comma-separated list of origins the frontend is actually served from.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# REQUIRED in production - the dev default lets anyone forge a valid
# login token. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-in-production
JWT_EXPIRY_MINUTES=480

# RS256 token signing (deploy/apply_sto.sh creates the key on a server). Blank =
# shared-secret tokens signed with JWT_SECRET_KEY, fine for local dev.
JWT_PRIVATE_KEY_FILE=
# Once every session from before RS256 has expired, turn shared-secret tokens off
JWT_ACCEPT_HS256=true

# Shared rate-limit counters across workers (the Docker setup sets this). Blank =
# each worker counts on its own.
REDIS_URL=

# Background jobs: "embedded" = one API worker runs them; "off" = a separate
# `python -m app.scheduler` process does (the Docker setup)
SCHEDULER_MODE=embedded

# One-time bootstrap accounts app.seed (or the users-table migration)
# creates if they don't already exist. Set real values here BEFORE first
# running the app against a production database, then change both
# passwords via the UI immediately after first login either way.
BOOTSTRAP_PLATFORM_ADMIN_EMAIL=platform-admin@brt360.local
BOOTSTRAP_PLATFORM_ADMIN_PASSWORD=change-me-now
BOOTSTRAP_TENANT_ADMIN_EMAIL=admin@default.local
BOOTSTRAP_TENANT_ADMIN_PASSWORD=change-me-now

# Public frontend origin used in personal assessment QR codes
TRAINING_PUBLIC_ORIGIN=

# Training messages (WFA-004). "outbox" (default) keeps every message in the
# training outbox and users' in-app messages - nothing leaves the server.
# "smtp" sends real email with the settings below.
TRAINING_EMAIL_ADAPTER=outbox
TRAINING_SMTP_HOST=
TRAINING_SMTP_PORT=587
TRAINING_SMTP_TLS=1
TRAINING_SMTP_USER=
TRAINING_SMTP_PASSWORD=
TRAINING_SMTP_FROM=

# Notifications by email (the notification service, app/crm_core/notification_delivery.py):
# "off" records what would have gone out (Admin -> Broadcasts -> delivery log);
# "smtp" sends through this account. Hostinger: smtp.hostinger.com, 465, SSL.
NOTIFY_EMAIL=off
SMTP_HOST=
SMTP_PORT=465
SMTP_SSL=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
