# Copy to .env and fill in for local dev.

# Defaults to a local SQLite file if unset - zero setup to get running.
# For Postgres: postgresql+psycopg2://user:password@localhost:5432/brt360
DATABASE_URL=sqlite:///./brt360.db

# Leave unset to run the deterministic rule-based classifier fallback
# (fully functional for dev/test, no external calls, no cost).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Comma-separated list of origins the frontend is actually served from.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# REQUIRED in production - the dev default lets anyone forge a valid
# login token. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-in-production
JWT_EXPIRY_MINUTES=480

# One-time bootstrap accounts app.seed (or the users-table migration)
# creates if they don't already exist. Set real values here BEFORE first
# running the app against a production database, then change both
# passwords via the UI immediately after first login either way.
BOOTSTRAP_PLATFORM_ADMIN_EMAIL=platform-admin@brt360.local
BOOTSTRAP_PLATFORM_ADMIN_PASSWORD=change-me-now
BOOTSTRAP_TENANT_ADMIN_EMAIL=admin@default.local
BOOTSTRAP_TENANT_ADMIN_PASSWORD=change-me-now
