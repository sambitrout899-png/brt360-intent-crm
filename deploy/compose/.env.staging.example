# deploy/compose/.env for STAGING (/opt/brt360-staging) - setup_staging.sh writes it.
# What makes it a separate stack from production on the same server:
COMPOSE_PROJECT_NAME=brt360-staging
IMAGE_PREFIX=brt360-staging
WEB_PORT=8082

POSTGRES_PASSWORD=
API_WORKERS=1
TRAINING_WORKERS=1
BRT_VERSION=local
AI_GATEWAY_TOKEN=

# Compose wants these set even though staging runs no monitoring
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3001
