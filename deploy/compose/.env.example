# Copy to deploy/compose/.env on the server (chmod 600). Compose reads it for the
# values in docker-compose.yml; the app's own settings stay in backend/.env.

# Postgres password - generate once:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Where the web container listens on the host (the host nginx passes traffic here)
WEB_PORT=8081

# API worker processes (4 vCPU shared with other projects: 3 is plenty)
API_WORKERS=3

# Image tag - set by the release pipeline later; "local" = built on this server
BRT_VERSION=local

# Shared by the app and the AI gateway: only the platform's own containers may call the
# gateway. apply.sh creates it if missing.  openssl rand -hex 24
AI_GATEWAY_TOKEN=

# Model calls per tenant per minute through the AI gateway (0 = no limit)
AI_GATEWAY_TENANT_RPM=60
# Tokens per tenant per month (0 = no budget); used up = rules until the 1st
AI_GATEWAY_TENANT_MONTHLY_TOKENS=0
# Mask emails, phones, card numbers and IBANs before prompts go to an external model
AI_GATEWAY_REDACT=true

# Worker processes of the split services (raise as their load grows)
TRAINING_WORKERS=2
BIM_WORKERS=1
PRODUCT_WORKERS=1
METADATA_WORKERS=1

# Grafana (docker compose --profile monitoring) - login "admin" with this password.
# Compose wants it set even while monitoring is off.  openssl rand -hex 16
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3000
